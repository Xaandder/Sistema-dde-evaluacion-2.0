# =============================================================
# PLANTILLA de configuracion local (perfil "local").
#
# INSTRUCCIONES:
#   1. Copia este archivo como "application-local.yml".
#   2. Completa los valores de tu equipo.
#   3. NUNCA subas application-local.yml a Git:
#      ya esta excluido en .gitignore.
#
# Alternativa: define las variables de entorno DB_URL, DB_USER
# y DB_PASSWORD en tu terminal y no copies nada aqui.
# =============================================================

# spring:
#   datasource:
#     url: ${DB_URL}          # Ej: jdbc:oracle:thin:@//localhost:1521/FREE
#     username: ${DB_USER}    # Usuario de la aplicacion (nunca en texto plano)
#     password: ${DB_PASSWORD} # Contraseña (nunca en texto plano)
